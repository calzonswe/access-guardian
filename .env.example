# Environment variables for docker-compose
# Copy this file to .env and update the values

# Database
DB_PASSWORD=changeme_in_production

# JWT Secret (used by backend for token signing, minimum 32 characters)
JWT_SECRET=changeme_jwt_secret_minimum_32_chars_long

# Initial admin account (only used on first startup)
# Leave blank to let the backend generate a one-shot password and print it to logs.
# INITIAL_ADMIN_EMAIL=admin@foretag.se
# INITIAL_ADMIN_PASSWORD=

# CORS Origin (restrict in production, e.g. https://yourdomain.com)
# CORS_ORIGIN=*

# Content-Security-Policy connect-src for the frontend nginx container.
# Defaults to 'self' (API proxied through nginx). If VITE_API_URL points
# to another host, list it here, e.g.:
# CSP_CONNECT_SRC="'self' https://api.example.com"

# Application port (exposed on host)
APP_PORT=8080

# Frontend API URL (optional, defaults to /api which nginx proxies to backend)
# VITE_API_URL=/api

# Attachment storage directory inside the backend container (mounted as volume)
# UPLOAD_DIR=/app/uploads

# Generic API rate limit (per authenticated user, otherwise per IP)
# API_RATE_LIMIT_MAX=600
# API_RATE_LIMIT_WINDOW_MS=60000

# Expiry job interval (ms). Default 3600000 (1h). Set 0 to disable.
# EXPIRY_JOB_INTERVAL_MS=3600000

# Azure AD / Entra ID (OIDC)
# AZURE_AD_TENANT_ID=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=

# ============= SMTP (e-postnotiser) =============
# Lämna SMTP_HOST tomt för att inaktivera e-post (notiser sker fortfarande in-app).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false              # true för port 465 (implicit TLS)
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Access Guardian <no-reply@yourdomain.com>"
# Basadress till appen, används i e-postlänkar
# APP_BASE_URL=https://access.yourdomain.com
